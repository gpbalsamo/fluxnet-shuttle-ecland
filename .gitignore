# ecLand runtime and generated output
scripts/work/
work/
output/
postprocessed/
benchmark/models/
results/
logs/
*.log
*.out
*.err

# Scheduler output
slurm-*.out

# Shuttle/FluxnetLSM pipeline intermediates -- regenerable, not source data
downloads/
fluxnetlsm_out/
fluxnet_shuttle_snapshot_*.csv
# fetch_fluxnet_ch4.py's raw per-site CSVs before convert_fluxnet_ch4.py runs
# (regenerable from the source zip/portal download); flux/fluxnet-ch4/ is the
# tracked product, same raw-vs-converted split as downloads/ above.
raw/

# clim/, forcing/, flux/ NetCDF content IS tracked (via Git LFS -- see
# .gitattributes and "Git LFS" in README.md), matching plumber2-ecland's
# convention. Nothing to ignore here; data lands directly under those dirs.

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Temporary and editor files
*.tmp
*.temp
*~
.#*
.DS_Store

# Local environments
.env
.venv/
venv/
postprocessed/date_validation.csv

# ECMWF sbatch jobfilter logs, written next to wherever sbatch was invoked.
# Named ecsbatch.log.<jobid>, so the *.log rule above does not catch them.
ecsbatch.log.*

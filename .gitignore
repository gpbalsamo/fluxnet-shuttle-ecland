# outputs once the surfclim/surfinit blocker is resolved and there's real
# data worth version-controlling)
clim/*/
forcing/*/
flux/*/
!clim/.gitkeep
!forcing/.gitkeep
!flux/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Temporary and editor files
*.tmp
*.temp
*~
.#*
.DS_Store


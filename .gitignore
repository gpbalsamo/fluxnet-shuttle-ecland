# ecLand runtime and generated output
scripts/work/
work/
output/
postprocessed/
benchmark/models/
results/
logs/
*.log
*.out
*.err

# Scheduler output
slurm-*.out

# Shuttle/FluxnetLSM pipeline intermediates -- regenerable, not source data
downloads/
fluxnetlsm_out/
fluxnet_shuttle_snapshot_*.csv

# NetCDF data -- large, regenerable via the pipeline; not tracked here (no
